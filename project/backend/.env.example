# ═══════════════════════════════════════════════════
# LLM 配置（自动检测：有 Key 用云端，无 Key 用本地 Ollama）
# ═══════════════════════════════════════════════════

# 提供商: deepseek / openai / ollama（默认 ollama）
LLM_PROVIDER=ollama

# 云端 API Key（填了哪个就用哪个，都不填则自动用 Ollama）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# 本地 Ollama（默认即可）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# ═══════════════════════════════════════════════════
# 高德地图（可选，不填则地图不显示）
# ═══════════════════════════════════════════════════
AMAP_KEY=

# ═══════════════════════════════════════════════════
# MCP 服务（可选，不启动对应 server 则降级到纯 LLM）
#   food   → port 8001  mcp_servers/food_server.py
#   ticket → port 8002  mcp_servers/ticket_server.py
#   hotel  → port 8003  app/mcp_servers/hotel_server.py
# ═══════════════════════════════════════════════════
FOOD_MCP_URL=http://localhost:8001/sse
TICKET_MCP_URL=http://localhost:8002/sse
HOTEL_MCP_URL=http://localhost:8003/sse

# ═══════════════════════════════════════════════════
# Redis 配置（可选）
#   USE_REDIS=false 或留空 → 内存模式（TaskStore/EventBus 不启用）
#   USE_REDIS=true          → Redis Hash 存任务 + Pub/Sub 推事件
# ═══════════════════════════════════════════════════
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_KEY_PREFIX=wandergraph
